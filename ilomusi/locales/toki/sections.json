  },
  "137": {
    "text": "󱥎 󱤶 󱤍. 󱥷 󱤶 󱤎 󱤊 󱤅 󱤳 󱥛 (ENDURANCE). 󱥩 󱤗 󱤞. 󱤰 󱤗 󱤞 󱤣 󱥩 󱥪 󱥔 󱤞 󱤼. 󱤮 palace 󱥚 󱥩 󱤝. 󱥮 󱤯: 󱥭 󱤶 anu 󱥭 Vizu-diar (trophy hall). wan 󱤯 󱥩 Imperial Apothecary (󱤗 Oede)."
  },
  "138": {
    "text": "󱤑 󱤈 󱥇 󱤯. 󱥞 󱥱 󱤭 󱥩 󱤤 󱤑 󱥳, 󱥆 󱤅. 󱤎 󱤷 󱥆 󱤅 󱥩 󱥃 󱥞."
  },
  "139": {
    "text": "󱥑 󱤼 󱤬 󱥘. 󱤂 󱤮 󱤛 󱤍 󱤬 󱥪. 󱥃 󱤛, 󱤅 󱤅. 󱤭 󱤛, 󱥨 󱥪 󱤍, 󱤦 󱥖 Kalte."
  },
  "140": {
    "text": "󱤯 󱤛 armoury 󱤂 󱤛. 󱥇 󱤯. 󱤕 󱤯 󱤍. 󱤏, supa 󱥉 󱤓 󱤎 󱥱. 󱤏 󱤎, 󱤪 󱥏 󱥣."
  },
  "141": {
    "text": "󱥞 󱥩 󱥒, 󱤷 󱤨 weka. Maouk 󱤕: '󱥌 󱥆! 󱤂 󱥌 󱥆 󱥶!' 󱥞 󱤬 󱤰 󱥒 󱤯 󱤅."
  },
  "142": {
    "text": "󱤅 󱥩 󱥪, 󱤔 󱤏 󱥪. Sharnazim 󱥩 󱤄 󱤰, 󱥜 󱥪. 󱤔 󱥩 󱤔 󱤨 󱥮󱤅󱤚 󱤰. 󱥪 󱤣 󱥔, 󱤮 󱤎 󱤬 󱤅 󱥪. 󱥢 Bloodlug (󱥢 󱥪 󱤍) 󱤖 󱥩 󱥞, 󱤶 󱥛!"
  },
  "143": {
    "text": "󱥞 󱥗 torch 󱥩 󱤯 󱥪. 󱥗 󱥣! 󱥪 󱤍 󱥗 󱥚 󱥩 󱤝! 󱤑 󱤼 󱥶 󱤊 󱤕 󱤍. Sewer gas 󱥗! 󱤄 󱤰 󱤍. 󱥩 󱤰 󱤋 󱥔. 󱥠: BARRAKEESH PUBLIC BATHS. 󱥇 󱤯, 󱥩 󱤏."
  },
  "144": {
    "text": "󱥎 󱤍 󱤏 󱥡. Kai 󱥡: 󱤍 󱥣 󱤬 󱥁 󱥭 󱤛. 󱥞 󱥱!"
  },
  "145": {
    "text": "󱥩 󱥪 󱤍, 󱤂 󱤝 kepeken 󱥰. 󱥪 󱤞 󱤍, 󱤝 󱤍. 󱤥 󱥰 kepeken Kai 󱤥. Maouk 󱤟 󱤖 󱤸. 󱤯 󱥚 󱥌 󱥪 󱤞. Baga-darooz 󱤬 󱤅 Linen Quarter. 󱤔 󱥪 󱤏 󱤰. 󱥢 󱥪 󱤍! 󱤥 󱥟 󱤛, 󱤮 󱥢 󱥪 weka. 󱤕 󱤍 󱤏 󱥏: Sharnazim 󱤷! 󱥞 󱥩 󱤰 󱤅󱤰."
  },
  "146": {
    "text": "󱤮 󱤑 󱤎 󱥱. 󱥆 󱥉 󱤬 󱤛. 󱥗 󱥣. 󱥩 󱤯 󱤅󱤰, 󱤥 󱤬 󱤛 󱤼."
  },
  "147": {
    "text": "Kai 󱥡: 󱤑 󱥔 󱥁 󱤂 󱥔. 󱥆 󱥷 󱤲 Silver."
